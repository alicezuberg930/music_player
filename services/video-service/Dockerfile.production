ARG BUN_VERSION=1.3.4

FROM oven/bun:${BUN_VERSION}-alpine AS base

FROM base AS prepare
WORKDIR /prune

RUN bun install --global turbo@2.6.3

COPY . .
RUN turbo prune @yukikaze/video-service --docker

FROM base AS builder
WORKDIR /build

COPY --from=prepare /prune/out/json ./
COPY --from=prepare /prune/out/bun.lock ./bun.lock
RUN bun install --frozen-lockfile

COPY --from=prepare /prune/out/full ./
RUN bun run build

RUN rm -rf node_modules && bun install --production --frozen-lockfile

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache curl ffmpeg
RUN addgroup --system --gid 1001 yukikaze && \
    adduser --system --uid 1001 video

COPY --from=builder --chown=video:yukikaze /build/node_modules ./node_modules
COPY --from=builder --chown=video:yukikaze /build/packages ./packages
COPY --from=builder --chown=video:yukikaze /build/services/video-service/dist ./dist
COPY --from=prepare --chown=video:yukikaze /prune/ca.pem ./ca.pem

RUN mkdir -p uploads && chown video:yukikaze uploads

USER video

EXPOSE 5009

CMD ["node", "dist/index.js"]
