    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.546.0",
    "next-themes": "^0.4.6",
    "react": "catalog:react",
    "react-day-picker": "^9.11.1",
    "react-dom": "catalog:react",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.15"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@yukikaze/typescript-config": "*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "tw-animate-css": "^1.4.0",
    "tsdown": "catalog:"
